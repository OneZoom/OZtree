#!/bin/sh

# This script is installed on the server by setup_deployment (as /opt/deploy/run.sh).
# __SSH_HOSTNAME__ is substituted at install time. It is run by a GitHub Action on push.

set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

cd /home/web2py/__SSH_HOSTNAME__/applications/OZtree
su -m web2py -c 'git pull'
su -m web2py -c 'grunt dev'
supervisorctl restart '__SSH_HOSTNAME__:*'

